{
  "name": "tg-notify",
  "version": "0.3.0",
  "description": "Telegram notification when Claude Code asks you something or needs permission",
  "author": {
    "name": "DEZZOMORF",
    "url": "https://github.com/DEZZOMORF"
  },
  "homepage": "https://github.com/DEZZOMORF/claude-code-tg-notify",
  "repository": "https://github.com/DEZZOMORF/claude-code-tg-notify",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "plugin",
    "telegram",
    "notifications",
    "hook"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notify.sh notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notify.sh ask"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notify.sh stop"
          }
        ]
      }
    ]
  }
}
